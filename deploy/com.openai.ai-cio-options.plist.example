<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Autonomous paper trader: weekdays 10:20 ET (after the 10:15 window opens).
  Install: replace REPLACE_WITH_* placeholders, then
    cp deploy/com.openai.ai-cio-options.plist.example ~/Library/LaunchAgents/com.openai.ai-cio-options.plist
    launchctl load ~/Library/LaunchAgents/com.openai.ai-cio-options.plist
  Paper only. Outside the session window the run researches and skips.
-->
<plist version="1.0"><dict>
  <key>Label</key><string>com.openai.ai-cio-options</string>
  <key>ProgramArguments</key><array>
    <string>REPLACE_WITH_TRADINGAGENTS_VENV_BIN/python</string>
    <string>scripts/tradingagents_paper_auto.py</string><string>--screen</string><string>outputs/screener/latest.json</string><string>--screen-top</string><string>2</string><string>--options</string>
  </array>
  <key>WorkingDirectory</key><string>REPLACE_WITH_REPOSITORY_PATH</string>
  <!-- LLM key: launchd agents do NOT inherit shell env. Replace with the real
       key at install time (file lives outside git in ~/Library/LaunchAgents). -->
  <key>EnvironmentVariables</key><dict>
    <key>NVIDIA_API_KEY</key><string>REPLACE_WITH_NVIDIA_API_KEY</string>
    <key>SEC_EDGAR_USER_AGENT</key><string>desk-research@localhost</string>
  </dict>
  <key>StartCalendarInterval</key><array><dict>
    <key>Weekday</key><integer>2</integer><key>Hour</key><integer>10</integer><key>Minute</key><integer>20</integer>
  </dict><dict>
    <key>Weekday</key><integer>3</integer><key>Hour</key><integer>10</integer><key>Minute</key><integer>20</integer>
  </dict><dict>
    <key>Weekday</key><integer>4</integer><key>Hour</key><integer>10</integer><key>Minute</key><integer>20</integer>
  </dict><dict>
    <key>Weekday</key><integer>5</integer><key>Hour</key><integer>10</integer><key>Minute</key><integer>20</integer>
  </dict><dict>
    <key>Weekday</key><integer>6</integer><key>Hour</key><integer>10</integer><key>Minute</key><integer>20</integer>
  </dict></array>
  <key>StandardOutPath</key><string>REPLACE_WITH_REPOSITORY_PATH/outputs/options-trader.log</string>
  <key>StandardErrorPath</key><string>REPLACE_WITH_REPOSITORY_PATH/outputs/options-trader-error.log</string>
</dict></plist>
