<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Weekly learning review: Sundays 18:00 ET settles due checkpoints into
  strategy observations and refreshes the standing lessons file.
  Install: replace REPLACE_WITH_* placeholders, then
    cp deploy/com.openai.ai-cio-learn.plist.example ~/Library/LaunchAgents/com.openai.ai-cio-learn.plist
    launchctl load ~/Library/LaunchAgents/com.openai.ai-cio-learn.plist
-->
<plist version="1.0"><dict>
  <key>Label</key><string>com.openai.ai-cio-learn</string>
  <key>ProgramArguments</key><array>
    <string>/opt/homebrew/bin/python3</string>
    <string>scripts/learn_from_trades.py</string>
  </array>
  <key>WorkingDirectory</key><string>REPLACE_WITH_REPOSITORY_PATH</string>
  <key>StartCalendarInterval</key><array><dict>
    <key>Weekday</key><integer>0</integer><key>Hour</key><integer>18</integer><key>Minute</key><integer>0</integer>
  </dict></array>
  <key>StandardOutPath</key><string>REPLACE_WITH_REPOSITORY_PATH/outputs/learn.log</string>
  <key>StandardErrorPath</key><string>REPLACE_WITH_REPOSITORY_PATH/outputs/learn-error.log</string>
</dict></plist>
