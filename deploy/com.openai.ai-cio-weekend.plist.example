<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Weekend digest: Saturdays 12:00 ET book review to Slack.
-->
<plist version="1.0"><dict>
  <key>Label</key><string>com.openai.ai-cio-weekend</string>
  <key>ProgramArguments</key><array>
    <string>/opt/homebrew/bin/python3</string>
    <string>scripts/weekend_digest.py</string><string>--send</string>
  </array>
  <key>WorkingDirectory</key><string>REPLACE_WITH_REPOSITORY_PATH</string>
  <key>StartCalendarInterval</key><array><dict>
    <key>Weekday</key><integer>6</integer><key>Hour</key><integer>12</integer><key>Minute</key><integer>0</integer>
  </dict></array>
  <key>StandardOutPath</key><string>REPLACE_WITH_REPOSITORY_PATH/outputs/weekend.log</string>
  <key>StandardErrorPath</key><string>REPLACE_WITH_REPOSITORY_PATH/outputs/weekend-error.log</string>
</dict></plist>
