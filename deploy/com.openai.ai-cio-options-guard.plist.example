<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Options position guard: every 15 minutes on weekdays -- the -25% cut /
  +2% take that the stock guard deliberately does NOT apply to OCC
  contracts (paper_position_guard.py skips them, "owned by options_guard").
  Without this job a long call has no automatic stop. Runs the same
  cadence as com.openai.ai-cio-guard. Paper only; sells travel
  review + ledger + guard, and a missing bid fails closed (never sells
  into air).
  Install: replace REPLACE_WITH_* placeholders, then
    cp deploy/com.openai.ai-cio-options-guard.plist.example ~/Library/LaunchAgents/com.openai.ai-cio-options-guard.plist
    launchctl load ~/Library/LaunchAgents/com.openai.ai-cio-options-guard.plist
-->
<plist version="1.0"><dict>
  <key>Label</key><string>com.openai.ai-cio-options-guard</string>
  <key>ProgramArguments</key><array>
    <string>REPLACE_WITH_TRADINGAGENTS_VENV_BIN/python</string>
    <string>scripts/options_guard.py</string><string>--execute</string>
  </array>
  <key>WorkingDirectory</key><string>REPLACE_WITH_REPOSITORY_PATH</string>
  <key>StartCalendarInterval</key><array>
    <dict><key>Weekday</key><integer>2</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Weekday</key><integer>2</integer><key>Minute</key><integer>15</integer></dict>
    <dict><key>Weekday</key><integer>2</integer><key>Minute</key><integer>30</integer></dict>
    <dict><key>Weekday</key><integer>2</integer><key>Minute</key><integer>45</integer></dict>
    <dict><key>Weekday</key><integer>3</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Weekday</key><integer>3</integer><key>Minute</key><integer>15</integer></dict>
    <dict><key>Weekday</key><integer>3</integer><key>Minute</key><integer>30</integer></dict>
    <dict><key>Weekday</key><integer>3</integer><key>Minute</key><integer>45</integer></dict>
    <dict><key>Weekday</key><integer>4</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Weekday</key><integer>4</integer><key>Minute</key><integer>15</integer></dict>
    <dict><key>Weekday</key><integer>4</integer><key>Minute</key><integer>30</integer></dict>
    <dict><key>Weekday</key><integer>4</integer><key>Minute</key><integer>45</integer></dict>
    <dict><key>Weekday</key><integer>5</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Weekday</key><integer>5</integer><key>Minute</key><integer>15</integer></dict>
    <dict><key>Weekday</key><integer>5</integer><key>Minute</key><integer>30</integer></dict>
    <dict><key>Weekday</key><integer>5</integer><key>Minute</key><integer>45</integer></dict>
    <dict><key>Weekday</key><integer>6</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Weekday</key><integer>6</integer><key>Minute</key><integer>15</integer></dict>
    <dict><key>Weekday</key><integer>6</integer><key>Minute</key><integer>30</integer></dict>
    <dict><key>Weekday</key><integer>6</integer><key>Minute</key><integer>45</integer></dict>
  </array>
  <key>StandardOutPath</key><string>REPLACE_WITH_REPOSITORY_PATH/outputs/options-guard.log</string>
  <key>StandardErrorPath</key><string>REPLACE_WITH_REPOSITORY_PATH/outputs/options-guard-error.log</string>
</dict></plist>
