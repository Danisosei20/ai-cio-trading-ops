<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Weekly scorecard: Sundays 18:30 ET (after the 18:00 learning review).
  Posts realized P&L, win rate, and desk stats to Slack.
  Install: replace REPLACE_WITH_* placeholders, then
    cp deploy/com.openai.ai-cio-scorecard.plist.example ~/Library/LaunchAgents/com.openai.ai-cio-scorecard.plist
    launchctl load ~/Library/LaunchAgents/com.openai.ai-cio-scorecard.plist
-->
<plist version="1.0"><dict>
  <key>Label</key><string>com.openai.ai-cio-scorecard</string>
  <key>ProgramArguments</key><array>
    <string>/opt/homebrew/bin/python3</string>
    <string>scripts/weekly_scorecard.py</string><string>--send</string>
  </array>
  <key>WorkingDirectory</key><string>REPLACE_WITH_REPOSITORY_PATH</string>
  <key>StartCalendarInterval</key><array><dict>
    <key>Weekday</key><integer>0</integer><key>Hour</key><integer>18</integer><key>Minute</key><integer>30</integer>
  </dict></array>
  <key>StandardOutPath</key><string>REPLACE_WITH_REPOSITORY_PATH/outputs/scorecard.log</string>
  <key>StandardErrorPath</key><string>REPLACE_WITH_REPOSITORY_PATH/outputs/scorecard-error.log</string>
</dict></plist>
