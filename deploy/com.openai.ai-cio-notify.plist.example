<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Desk change watcher: every 5 minutes on weekdays, Slack on fills,
  position changes, and guard STOP/TARGET only (silent otherwise).
  Install: replace REPLACE_WITH_* placeholders, then
    cp deploy/com.openai.ai-cio-notify.plist.example ~/Library/LaunchAgents/com.openai.ai-cio-notify.plist
    launchctl load ~/Library/LaunchAgents/com.openai.ai-cio-notify.plist
-->
<plist version="1.0"><dict>
  <key>Label</key><string>com.openai.ai-cio-notify</string>
  <key>ProgramArguments</key><array>
    <string>/opt/homebrew/bin/python3</string>
    <string>scripts/notify.py</string><string>--watch</string>
  </array>
  <key>WorkingDirectory</key><string>REPLACE_WITH_REPOSITORY_PATH</string>
  <key>StartInterval</key><integer>300</integer>
  <key>StandardOutPath</key><string>REPLACE_WITH_REPOSITORY_PATH/outputs/notify.log</string>
  <key>StandardErrorPath</key><string>REPLACE_WITH_REPOSITORY_PATH/outputs/notify-error.log</string>
</dict></plist>
